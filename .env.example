# ===== WAJIB =====
# Token dari @BotFather (format: 123456:ABC-...)
BOT_TOKEN=123456:ABC-your-bot-token-here

# ===== OWNER / ADMIN =====
# Telegram user ID owner (cek lewat /myid di bot). Bisa 1 ID atau banyak dipisah koma.
ADMIN_ID=
# ADMIN_IDS=123456789,987654321

# ===== LIMIT & PERFORMANCE =====
MAX_COOKIES_PER_REQUEST=10000
MAX_CONCURRENCY=10                # request Netflix bersamaan PER USER
# Batas total request bersamaan KESELURUHAN user (anti rate-limit).
# Naikkan kalau server kuat & koneksi luar bagus, turunkan kalau kena rate-limit.
GLOBAL_MAX_WORKERS=20
# Jumlah akun valid yang dikirim sebagai card satu-per-satu ke chat.
# Akun berlebih tetap ada di valid_accounts.txt / Hits.zip / Telegra.ph.
# Set 0 = kirim semua.
MAX_CARDS_TO_SEND=50
REQUEST_TIMEOUT=15

# ===== HEALTH SERVER (opsional) =====
# Port HTTP /health. Berguna untuk monitoring/uptime check.
PORT=8000
